<resources>
    <style name="BaseAppTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="pageBackground">#10151D</item>
        <item name="cardBackground">#1A2330</item>
        <item name="buttonBackground">#2A394A</item>
        <item name="primaryText">#F2F6FC</item>
        <item name="secondaryText">#AAB8C8</item>
        <item name="accentColor">#52E0BC</item>
        <item name="warningColor">#F5CB82</item>
        <item name="lineColor">#3E4E62</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#52E0BC</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowBackground">#10151D</item>
        <item name="android:statusBarColor">#10151D</item>
        <item name="android:navigationBarColor">#10151D</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
    <style name="AppTheme" parent="BaseAppTheme" />
    <style name="LightAppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#007A60</item>
        <item name="android:windowBackground">#F2F5F9</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">#F2F5F9</item>
        <item name="android:navigationBarColor">#F2F5F9</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="pageBackground">#F2F5F9</item>
        <item name="cardBackground">#FFFFFF</item>
        <item name="buttonBackground">#E4EBF2</item>
        <item name="primaryText">#182638</item>
        <item name="secondaryText">#506175</item>
        <item name="accentColor">#007A60</item>
        <item name="warningColor">#805000</item>
        <item name="lineColor">#BAC8D8</item>
    </style>
    <style name="Card">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">16dp</item>
        <item name="android:padding">18dp</item>
        <item name="android:background">@drawable/card</item>
        <item name="android:orientation">vertical</item>
    </style>
    <style name="Caption">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">?attr/secondaryText</item>
        <item name="android:textSize">13sp</item>
        <item name="android:lineSpacingExtra">4dp</item>
    </style>
    <style name="ActionButton" parent="android:style/Widget.Material.Button">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
    </style>
</resources>
