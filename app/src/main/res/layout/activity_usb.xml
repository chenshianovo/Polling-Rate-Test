<?xml version="1.0" encoding="utf-8"?>
<ScrollView android:tag="page" xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/usb_root" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
        <TextView style="@style/Caption" android:layout_marginTop="8dp" android:text="@string/usb_title" android:textSize="26sp" android:textStyle="bold" android:textColor="?attr/primaryText" android:tag="primary" />
        <Button android:id="@+id/overlay_button" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/overlay_button" />
        <com.gamepad.rate.CollapsibleCard style="@style/Card" android:tag="activity_usb.xml_0|设备与通道">
            <TextView android:id="@+id/usb_device_name" style="@style/Caption" android:textSize="18sp" android:textStyle="bold" android:textColor="?attr/primaryText" android:tag="primary" />
            <TextView android:id="@+id/usb_connection" style="@style/Caption" android:layout_marginTop="8dp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <Button android:id="@+id/usb_choose_device" style="@style/ActionButton" android:text="@string/usb_device" />
            </LinearLayout>
            <Button android:id="@+id/usb_choose_channel" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/usb_channel" />
            <TextView android:id="@+id/usb_channel_name" style="@style/Caption" android:textIsSelectable="true" />
            <Button android:id="@+id/usb_disconnect" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/usb_disconnect" />
        </com.gamepad.rate.CollapsibleCard>
        <com.gamepad.rate.CollapsibleCard style="@style/Card" android:tag="activity_usb.xml_1|测试与导出">
            <TextView style="@style/Caption" android:text="@string/usb_rate" />
            <TextView android:id="@+id/usb_rate" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/empty_rate" android:textColor="?attr/accentColor" android:tag="accent" android:textSize="60sp" android:textStyle="bold" android:fontFamily="monospace" />
            <TextView android:id="@+id/usb_status" style="@style/Caption" android:textColor="?attr/primaryText" android:tag="primary" />
            <TextView android:id="@+id/usb_timer" style="@style/Caption" android:layout_marginTop="8dp" />
            <TextView android:id="@+id/usb_reports" style="@style/Caption" android:visibility="gone" android:layout_marginTop="8dp" />
            <Button android:id="@+id/usb_report_counting" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/report_counting_off" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <Button android:id="@+id/usb_start_stop" android:tag="action" style="@style/ActionButton" android:text="@string/start" />
                <Button android:id="@+id/usb_duration" style="@style/ActionButton" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <Button android:id="@+id/usb_clear" style="@style/ActionButton" android:text="@string/clear" />
                <Button android:id="@+id/usb_export" style="@style/ActionButton" android:text="@string/export" />
            </LinearLayout>
        </com.gamepad.rate.CollapsibleCard>
        <com.gamepad.rate.CollapsibleCard style="@style/Card" android:tag="activity_usb.xml_2|统计与曲线">
            <TextView android:id="@+id/usb_statistics" style="@style/Caption" android:textColor="?attr/primaryText" android:tag="primary" android:textSize="15sp" android:fontFamily="monospace" android:lineSpacingExtra="6dp" />
            <TextView style="@style/Caption" android:layout_marginTop="12dp" android:text="@string/chart_label" />
            <com.gamepad.rate.IntervalChartView android:id="@+id/usb_chart" android:layout_width="match_parent" android:layout_height="170dp" android:contentDescription="@string/chart_description" />
        </com.gamepad.rate.CollapsibleCard>
        <com.gamepad.rate.CollapsibleCard style="@style/Card" android:tag="activity_usb.xml_3|原始数据预览">
            <TextView style="@style/Caption" android:text="@string/ble_payload" />
            <TextView android:id="@+id/usb_hex" style="@style/Caption" android:layout_marginTop="10dp" android:fontFamily="monospace" android:textIsSelectable="true" />
        </com.gamepad.rate.CollapsibleCard>
    </LinearLayout>
</ScrollView>
